rules_version = '2';

// ---------------------------------------------------------------------------
// Reglas de seguridad multi-empresa para MilePay.
// Aislamiento por companyId: un usuario solo accede a documentos cuya
// companyId coincide con la de su documento en `users`. El súper-admin
// (users/{uid}.superAdmin == true) accede a todo.
//
// ROL "driver" (chofer): acceso MUY limitado. Solo puede LEER:
//   - su propio documento en `drivers` (el de su driverId)
//   - sus propios `claims` (donde courier == su driverNombre)
//   - sus propios `payroll` y `driverStats` (donde driverNombre/driverKey == el suyo)
//   NO puede leer invoices, otros drivers, users, companies, managers, settings
//   ni alertEstados. Tampoco puede escribir en ninguna colección de datos.
//
// Desplegar con:  firebase deploy --only firestore:rules
// (o pegar en Firebase Console → Firestore → Reglas)
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Súper-admin por CORREO verificado (respaldo "break-glass"): garantiza el
    // acceso del dueño de la plataforma aunque su doc en `users` tenga cualquier
    // problema. Edita esta lista con tu(s) correo(s) de súper-admin.
    function isSuperEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['gabriele.brandonisio.o@gmail.com'];
    }
    // Súper-admin: por correo (respaldo) o por flag superAdmin==true en su doc.
    function isSuper() {
      return isSuperEmail() || (hasProfile() && userDoc().superAdmin == true);
    }
    function role() {
      return hasProfile() ? userDoc().role : '';
    }
    function isDriver() {
      return role() == 'driver';
    }
    // Personal = staff de la empresa (owner/admin/manager/súper-admin), NO chofer.
    function isStaff(cid) {
      return isSuper() || (hasProfile() && !isDriver() && userDoc().companyId == cid);
    }
    function myCompany() {
      return hasProfile() ? userDoc().companyId : null;
    }
    // Datos "de empresa" (finanzas, agregados): solo staff, NUNCA un chofer.
    function inCompany(cid) {
      return isStaff(cid);
    }
    // Nombre / clave / id del chofer vinculado al usuario (rol driver).
    function myDriverName() {
      return hasProfile() ? userDoc().driverNombre : '';
    }
    function myDriverKey() {
      return hasProfile() ? userDoc().driverKey : '';
    }
    function myDriverId() {
      return hasProfile() ? userDoc().driverId : '';
    }

    // Empresas: solo staff de esa empresa o súper-admin. Escritura súper-admin.
    match /companies/{companyId} {
      allow read: if isStaff(companyId);
      allow create, update, delete: if isSuper();
    }

    // Usuarios: cada uno lee su PROPIO doc. El staff (no chofer) lee los usuarios de
    // su empresa. Un chofer solo puede leer su propio documento.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper() || (hasProfile() && !isDriver() && myCompany() == resource.data.companyId));
      // Crear / editar / borrar usuarios: SOLO el dueño (o súper-admin) de la empresa.
      // Así un manager no puede cambiar roles ni permisos de nadie.
      allow create, update, delete: if isSuper() || (hasProfile() && role() == 'owner' && myCompany() == request.resource.data.companyId);
      // Excepción: CUALQUIER usuario puede guardar SOLO su preferencia de filtro
      // (prefFiltro) en su propio doc — sin poder tocar rol, permisos, ciudad ni empresa.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefFiltro']);
    }

    // Facturas / agregados financieros: solo staff. Un chofer NO puede leerlas.
    match /invoices/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Drivers: el staff gestiona todos; un chofer solo LEE su propio doc.
    match /drivers/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && id == myDriverId());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Claims: el staff gestiona todos; un chofer solo LEE los suyos (courier == su nombre).
    match /claims/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && resource.data.courier == myDriverName());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Nómina: el staff gestiona; un chofer solo LEE la suya (driverNombre == su nombre).
    match /payroll/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && resource.data.driverNombre == myDriverName());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Resumen por chofer y semana (para el portal del chofer). El chofer solo lee
    // las filas suyas (driverKey == la suya). Lo escribe el staff al cargar facturas.
    match /driverStats/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && resource.data.driverKey == myDriverKey());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Managers (costo de empresa): solo staff.
    match /managers/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }
    // Estado de alertas: solo staff.
    match /alertEstados/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }
    // Configuración por empresa: solo staff.
    match /settings/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Señal de cierre de sesión forzado (Package): la emite el dueño/superadmin; la
    // leen TODOS los usuarios de la empresa (incl. choferes) para cerrar su sesión.
    // El doc id es el companyId. No se borra.
    match /authSignals/{companyId} {
      allow read: if signedIn() && (isSuper() || (hasProfile() && myCompany() == companyId));
      allow create, update: if isSuper() || (hasProfile() && role() == 'owner' && myCompany() == companyId);
      allow delete: if false;
    }

    // =========================================================================
    // MÓDULO BULK — namespace `bulk_*` (independiente de Package).
    // Requiere Firebase Auth con CUSTOM CLAIMS puestas por el backend
    // (functions: crearUsuarioBulk / bootstrapMasterBulk):
    //   token.bulkTenant, token.bulkRole, token.bulkClienteId?, token.bulkCarrierId?
    // Aislamiento estricto por bulkTenant. Los usuarios se crean por el backend
    // (Admin SDK), por eso `bulk_users` no acepta escritura directa del cliente.
    // =========================================================================
    function bT() { return request.auth != null ? request.auth.token.bulkTenant : null; }
    function bRole() { return request.auth != null ? request.auth.token.bulkRole : null; }
    function bSigned() { return request.auth != null && bT() != null; }
    function bSame(cid) { return bSigned() && bT() == cid; }
    // Staff = miembro del tenant que NO es un rol de la CADENA (cliente/transportista/
    // chofer/supervisor). Así, además de super_admin/admin/dispatcher, cualquier ROL
    // PERSONALIZADO (accountant, auditor, broker…) tiene acceso operativo de staff. Los
    // roles de la cadena siguen aislados por sus propias reglas. Los límites duros
    // (gestión de usuarios, margen del cliente, borrar órdenes) son bAdmin, no bStaff.
    function bStaff(cid) { return bSame(cid) && bRole() != null && !(bRole() in ['cliente', 'transportista', 'chofer', 'supervisor_planta']); }
    function bAdmin(cid) { return bSame(cid) && (bRole() in ['super_admin', 'admin']); }
    function bCliente() { return request.auth != null ? request.auth.token.bulkClienteId : null; }
    function bCarrier() { return request.auth != null ? request.auth.token.bulkCarrierId : null; }
    // Planta asignada al supervisor (LEGADO; en su doc de usuario). Se conserva como
    // respaldo para supervisores aún no migrados a trabajos.
    function bMyPlanta() { return request.auth != null && exists(/databases/$(database)/documents/bulk_users/$(request.auth.uid)) ? get(/databases/$(database)/documents/bulk_users/$(request.auth.uid)).data.plantaId : null; }
    // TRABAJOS (jobs) asignados al supervisor: el alcance actual de sus lecturas.
    function bMyJobs() { return request.auth != null && exists(/databases/$(database)/documents/bulk_users/$(request.auth.uid)) ? get(/databases/$(database)/documents/bulk_users/$(request.auth.uid)).data.get('jobIds', []) : []; }
    // ¿La orden cae dentro del alcance del supervisor? Por JOB (modelo nuevo) o,
    // como respaldo, por planta (supervisores legado sin jobs asignados).
    function bSupervisorVe(d) {
      return (d.get('jobId', '') != '' && d.get('jobId', '') in bMyJobs())
        || (bMyPlanta() != null && d.get('plantaId', '') == bMyPlanta());
    }
    // Nombre del chofer (de su doc de usuario). Sirve para que pueda avanzar/aceptar
    // una orden que se le ofreció por NOMBRE o por id del roster (no solo por uid).
    function bMyName() { return request.auth != null && exists(/databases/$(database)/documents/bulk_users/$(request.auth.uid)) ? get(/databases/$(database)/documents/bulk_users/$(request.auth.uid)).data.nombre : null; }

    // Aislamiento financiero DURO de la orden: el documento de la orden NUNCA debe
    // quedar con un precio con valor (los importes viven en bulk_orderPay_*). Así,
    // aunque un transportista/cliente/chofer pueda LEER su orden, no hay márgenes
    // que leer en ella. Vale para cualquier escritor (incluido staff).
    function bSinValorPrecio(d) {
      return (!('precioCliente' in d) || d.precioCliente == null)
          && (!('precioTransportista' in d) || d.precioTransportista == null)
          && (!('pagoChofer' in d) || d.pagoChofer == null);
    }
    // En UPDATE se permite: (a) que el doc resultante no tenga precios con valor
    // (incluye el "corte" que los borra), o (b) que la escritura no TOQUE ningún
    // campo de precio (avanzar el estado de una orden vieja sin migrar). Bloquea
    // fijar o inflar cualquier precio en la orden.
    function bOrdenPrecioOk() {
      return bSinValorPrecio(request.resource.data)
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['precioCliente', 'precioTransportista', 'pagoChofer']);
    }
    // Quién puede ACTUALIZAR una orden (además del guardián de precios de arriba):
    // el staff todo; los no-staff pueden AVANZAR la operación (estado, hitos, ticket,
    // POD, GPS) pero NUNCA cambiar precioCliente/precioTransportista; el chofer y el
    // supervisor tampoco pagoChofer (ese lo fija el transportista al asignar). Todas
    // las lecturas de identidad usan .get(…) para no romper si falta un campo.
    // REGLA CRÍTICA DE SEGURIDAD (entregas): NINGÚN cliente —ni siquiera staff—
    // puede escribir el estado 'entregada', ni saltar a 'liberada' sin venir de
    // 'entregada'. La ÚNICA vía de entrega es la Cloud Function bulkEntregarOrden
    // (Admin SDK), que exige un token de supervisor válido. Así, aunque alguien
    // modifique la app o llame a la API de Firestore directamente, no puede
    // poner una orden en entregada/liberada sin autorización.
    //   · estado → 'entregada': prohibido para clientes (solo backend).
    //   · estado → 'liberada' : solo desde 'entregada' (liberación de órdenes
    //     LEGADO que quedaron entregadas antes de este candado).
    function bTransicionEntregaOk() {
      return (request.resource.data.get('estado', '') != 'entregada' || resource.data.get('estado', '') == 'entregada')
          && (request.resource.data.get('estado', '') != 'liberada' || resource.data.get('estado', '') in ['entregada', 'liberada']);
    }
    function bPuedeActualizarOrden() {
      return bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['precioCliente', 'precioTransportista'])
            && (
             (bRole() == 'transportista' && resource.data.get('transportistaId', '') == bCarrier())
          || (bRole() == 'chofer'
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pagoChofer'])
                && (resource.data.get('choferId', '') == request.auth.uid
                    || (bCarrier() != null && resource.data.get('transportistaId', '') == bCarrier())
                    || resource.data.get('choferNombre', '') == bMyName()))
          || (bRole() == 'supervisor_planta'
                && bSupervisorVe(resource.data)
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pagoChofer']))));
    }

    // Perfiles Bulk: lee el propio o admin del tenant. Alta/edición: backend (Admin SDK).
    match /bulk_users/{id} {
      allow read: if bSame(resource.data.tenantId) && (request.auth.uid == id || bAdmin(resource.data.tenantId));
      // Alta/edición general: backend (Admin SDK). Excepción: el admin del tenant
      // puede asignar SOLO la planta de un supervisor (plantaId) y el ID legible de
      // 8 dígitos (codigo). La foto de perfil vive en bulk_avatars (ver abajo).
      allow update: if bAdmin(resource.data.tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plantaId', 'codigo', 'jobIds', 'jobsNombres']);
      allow create, delete: if false;
    }

    // Avatares (foto de perfil). Doc id = uid del usuario. La foto NO es dato sensible
    // y debe verse dentro de la empresa (chat, listas, tarjetas), así que la LEE cualquier
    // miembro del tenant. La ESCRIBE el propio usuario (su avatar) o el staff (el de
    // cualquiera). Solo contiene { tenantId, foto } — nunca rol, correo ni credenciales.
    match /bulk_avatars/{id} {
      allow read: if bSame(resource.data.tenantId);
      allow create, update: if bSame(request.resource.data.tenantId) && (request.auth.uid == id || bStaff(request.resource.data.tenantId));
      allow delete: if bStaff(resource.data.tenantId) || (bSame(resource.data.tenantId) && request.auth.uid == id);
    }

    // RBAC configurable: permisos por rol del tenant. Doc id = tenantId; el campo
    // `roles` = { [rol]: { permisos: [...] } }. Lo LEE cualquier miembro del tenant
    // (para conocer los permisos de su propio rol); solo un admin/super_admin lo
    // ESCRIBE. NO afecta el aislamiento financiero (lo imponen las reglas de
    // bulk_orderPay_*): esto solo configura módulos/acciones/vista de la interfaz.
    match /bulk_roles/{id} {
      allow read: if bSame(id);
      allow create, update: if bAdmin(id);
      allow delete: if false;
    }

    // DIRECTORIO del tenant (descubrimiento de contactos del chat interno). Doc id =
    // uid. Contiene SOLO datos NO sensibles { tenantId, uid, nombre, rol, carrierId?,
    // clienteId?, codigo? } para que CUALQUIER miembro (incluido un chofer, que NO puede
    // leer bulk_users) pueda descubrir a sus contactos permitidos. Lo escribe el propio
    // usuario (su ficha) o el staff (backfill/altas). Nunca lleva correo ni credenciales.
    match /bulk_directorio/{id} {
      allow read: if bSame(resource.data.tenantId);
      allow create, update: if bSame(request.resource.data.tenantId) && (request.auth.uid == id || bStaff(request.resource.data.tenantId));
      allow delete: if bStaff(resource.data.tenantId);
    }

    // MATRIZ de comunicación configurable (quién puede chatear con quién, por rol).
    // Doc id = tenantId; `pares` = { 'rolA|rolB': true|false }. La LEE cualquier miembro
    // (para saber con quién puede hablar); solo un admin/super_admin la ESCRIBE, de modo
    // que la política se ajusta SIN TOCAR CÓDIGO. No afecta el aislamiento financiero.
    match /bulk_comMatrix/{id} {
      allow read: if bSame(id);
      allow create, update: if bAdmin(id);
      allow delete: if false;
    }

    // Registro de CONVERSACIONES privadas (chat interno 1-a-1). La crea SOLO el backend
    // (Cloud Function bulkChatPrivado) tras validar la matriz + la misma compañía; el
    // cliente NO puede escribir aquí. La LEEN sus participantes (para listarla) y el
    // admin. Sirve además de guardián: un mensaje pv_ solo se acepta si su conversación
    // existe y el autor es participante (ver bulk_messages).
    match /bulk_conversaciones/{id} {
      allow read: if bSame(resource.data.tenantId) && (bAdmin(resource.data.tenantId) || request.auth.uid in resource.data.participantes);
      allow create, update, delete: if false;
    }

    // Red de CONTACTOS entre choferes. La lista de contactos/bloqueados/ajustes de cada
    // chofer (doc id = su uid) solo la LEE él mismo; TODA escritura pasa por la Cloud
    // Function `bulkContacto` (valida consentimiento, bloqueo, restricción). No expone
    // datos de otros: para pintar a un contacto se usa el directorio (ya legible).
    match /bulk_contacts/{id} {
      allow read: if bSigned() && request.auth.uid == id;
      allow create, update, delete: if false;
    }
    // Solicitudes de contacto: solo las ven el emisor y el receptor. Se crean/gestionan
    // desde el backend (consentimiento obligatorio).
    match /bulk_contactRequests/{id} {
      allow read: if bSame(resource.data.tenantId) && (request.auth.uid == resource.data.deUid || request.auth.uid == resource.data.paraUid);
      allow create, update, delete: if false;
    }
    // Reportes de usuarios: solo el admin los lee; se crean por el backend.
    match /bulk_reports/{id} {
      allow read: if bAdmin(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // Catálogos y entidades gestionadas por staff del tenant.
    match /bulk_clients/{id}   { allow read: if bStaff(resource.data.tenantId); allow create: if bStaff(request.resource.data.tenantId); allow update, delete: if bStaff(resource.data.tenantId); }
    // Plantas = puntos de RECOGIDA. Cualquier usuario del tenant (chofer, transportista,
    // supervisor, cliente) necesita el nombre/dirección/GPS para navegar; no hay precios
    // aquí. Escritura solo staff.
    match /bulk_plants/{id}    { allow read: if bSame(resource.data.tenantId); allow create: if bStaff(request.resource.data.tenantId); allow update, delete: if bStaff(resource.data.tenantId); }
    match /bulk_jobs/{id}      { allow read: if bStaff(resource.data.tenantId); allow create: if bStaff(request.resource.data.tenantId); allow update, delete: if bStaff(resource.data.tenantId); }
    // Transportistas: staff gestiona todo. Además, el PROPIO transportista puede
    // gestionar SU roster de choferes (solo el campo `choferes` de SU carrier), para
    // dar de alta/activar sus choferes desde su portal. No puede tocar tenantId,
    // nombre, equipos, ni el carrier de otro. Aislamiento estricto por bCarrier()==id.
    match /bulk_carriers/{id} {
      allow read: if bSame(resource.data.tenantId);
      allow create: if bStaff(request.resource.data.tenantId);
      allow update: if bStaff(resource.data.tenantId)
        || (bRole() == 'transportista' && bSame(resource.data.tenantId) && bCarrier() == id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['choferes', 'actualizadoEn']));
      allow delete: if bStaff(resource.data.tenantId);
    }
    // Config del transportista (cómo le paga a sus choferes). SOLO el propio
    // transportista (rol transportista + su carrierId) o el staff. Un chofer NO
    // puede leerla ni escribirla aunque comparta bulkCarrierId (fuga L5 cerrada).
    match /bulk_carrierConfig/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(resource.data.tenantId) && bCarrier() == id);
      allow create: if bStaff(request.resource.data.tenantId) || (bRole() == 'transportista' && bSame(request.resource.data.tenantId) && bCarrier() == id);
      allow update: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(request.resource.data.tenantId) && bCarrier() == id);
      allow delete: if bStaff(resource.data.tenantId);
    }
    // Avisos de pago a transportistas (los emite el staff; el transportista lee los suyos).
    match /bulk_carrierStatements/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.carrierId == bCarrier());
      allow create: if bStaff(request.resource.data.tenantId);
      allow update, delete: if bStaff(resource.data.tenantId);
    }
    match /bulk_materials/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_equipment/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_geofences/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_tariffs/{id}   { allow read: if bStaff(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_incidents/{id} { allow read: if bStaff(resource.data.tenantId); allow create, update: if bStaff(request.resource.data.tenantId) || bStaff(resource.data.tenantId); allow delete: if bAdmin(resource.data.tenantId); }
    match /bulk_documents/{id} { allow read: if bStaff(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }

    // Órdenes: staff todo; chofer las suyas; transportista las de su carrier; cliente las suyas.
    match /bulk_orders/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && (
             (bRole() == 'chofer' && (resource.data.choferId == request.auth.uid || resource.data.transportistaId == bCarrier()))
          || (bRole() == 'transportista' && resource.data.transportistaId == bCarrier())
          || (bRole() == 'cliente' && resource.data.clienteId == bCliente())
          || (bRole() == 'supervisor_planta' && bSupervisorVe(resource.data))));
      // La orden se crea SIEMPRE sin precios (viven en bulk_orderPay_*). El staff crea.
      // Y NUNCA nace ya entregada/liberada/cerrada — única excepción: datos de
      // DEMO sembrados por un admin (docs marcados demo:true, entorno de prueba).
      allow create: if bStaff(request.resource.data.tenantId) && bSinValorPrecio(request.resource.data)
        && (!(request.resource.data.get('estado', '') in ['entregada', 'liberada', 'cerrada'])
            || (bAdmin(request.resource.data.tenantId) && request.resource.data.get('demo', false) == true));
      // Los roles NO-staff pueden avanzar la operación (estado, hitos, ticket,
      // POD, GPS…) pero NUNCA modificar los precios. Guardas por campo con .get(…,0)
      // para NO fallar si a la orden le falta algún campo de precio (antes eso
      // rompía la regla y denegaba el avance del chofer — "Missing permissions").
      //  - precioCliente y precioTransportista: intocables por cualquier no-staff.
      //  - pagoChofer: el transportista SÍ lo fija al asignar; el chofer/supervisor NO.
      // El chofer puede avanzar la orden que es suya por uid, por su carrier, o que se
      // le ofreció por NOMBRE (asignación por id del roster).
      // Protección por diff().affectedKeys(): el no-staff puede avanzar la orden pero
      // NO puede CAMBIAR los precios. Este patrón NUNCA falla por campos ausentes
      // (a diferencia de comparar resource.data.precioX, que rompía la regla y daba
      // "Missing permissions"). Todas las lecturas de identidad usan .get(…) por si
      // a la orden le falta algún campo.
      allow update: if bOrdenPrecioOk() && bTransicionEntregaOk() && bPuedeActualizarOrden();
      allow delete: if bAdmin(resource.data.tenantId);
    }

    // ── Liberación de entregas con token de supervisor (solo backend escribe) ──
    // Secreto TOTP de cada supervisor: NADIE lo lee ni escribe desde el cliente.
    match /bulk_supervisorTotp/{id} {
      allow read, write: if false;
    }
    // Autorizaciones consumidas (1 por orden): historial/auditoría. Lee el staff,
    // el supervisor las SUYAS y el empleado las suyas. Inmutables desde clientes.
    match /bulk_liberaciones/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && (resource.data.supervisorId == request.auth.uid || resource.data.empleadoId == request.auth.uid));
      allow create, update, delete: if false;
    }
    // Intentos fallidos / bloqueo anti fuerza bruta. Solo backend escribe.
    match /bulk_authAttempts/{id} {
      allow read: if bStaff(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // ── Inc.2 · Pagos por audiencia (separación de márgenes) ─────────────────
    // Cada orden proyecta su precio a 3 docs (mismo id que la orden) para que cada
    // rol lea SOLO su número. Los precios de cliente y transportista los fija SOLO
    // el staff (nadie puede inflar lo que se le cobra/paga). El pago al chofer lo
    // fija su transportista.
    match /bulk_orderPay_cliente/{id} {
      // La tarifa del cliente revela el MARGEN del dueño (margen = tarifa − pago
      // al transportista). Por eso su LECTURA es solo ADMIN (no dispatcher): así un
      // dispatcher no puede deducir la ganancia del negocio ni por API. El cliente
      // ve la suya. La escritura sigue siendo de staff (se crea al generar la orden).
      allow read: if bAdmin(resource.data.tenantId) || (bRole() == 'cliente' && bSame(resource.data.tenantId) && resource.data.clienteId == bCliente());
      allow create, update, delete: if bStaff(request.resource.data.tenantId) || bStaff(resource.data.tenantId);
    }
    match /bulk_orderPay_carrier/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.transportistaId == bCarrier());
      allow create, update, delete: if bStaff(request.resource.data.tenantId) || bStaff(resource.data.tenantId);
    }
    match /bulk_orderPay_chofer/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bRole() == 'chofer' && bSame(resource.data.tenantId) && resource.data.choferId == request.auth.uid)
        || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.transportistaId == bCarrier());
      allow create, update: if bStaff(request.resource.data.tenantId)
        || (bRole() == 'transportista' && bSame(request.resource.data.tenantId) && request.resource.data.transportistaId == bCarrier());
      allow delete: if bStaff(resource.data.tenantId);
    }

    // Facturas: staff crea; cliente lee/firma las suyas.
    match /bulk_invoices/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'cliente' && bSame(resource.data.tenantId) && resource.data.clienteId == bCliente());
      allow create: if bStaff(request.resource.data.tenantId);
      // El cliente puede FIRMAR (estado='firmada') o DISPUTAR (estado='rechazada')
      // su factura — solo esos campos. No puede tocar total, líneas ni marcarla pagada.
      allow update: if bStaff(resource.data.tenantId)
        || (bRole() == 'cliente' && bSame(resource.data.tenantId) && resource.data.clienteId == bCliente()
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'firma', 'firmante', 'firmadaEn']) && request.resource.data.estado == 'firmada')
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoRechazo', 'rechazadaEn']) && request.resource.data.estado == 'rechazada')
            ));
      allow delete: if bAdmin(resource.data.tenantId);
    }

    // Mensajes de orden y GPS: cualquier miembro autenticado del tenant.
    // Mensajes de orden y oficina. Los chats de ORDEN llevan `participantes` (uid del
    // chofer, id del carrier, id del cliente, autor): solo ellos + staff los leen. Los
    // de oficina (sin ese campo) siguen legibles por cualquier miembro del tenant (el
    // staff y el interlocutor; el cliente no descarga chats ajenos por consulta).
    match /bulk_messages/{id} {
      allow read: if bSame(resource.data.tenantId) && (
           bStaff(resource.data.tenantId)
        || !('participantes' in resource.data)
        || request.auth.uid in resource.data.participantes
        || (bCarrier() != null && bCarrier() in resource.data.participantes)
        || (bCliente() != null && bCliente() in resource.data.participantes)
      );
      // Crear mensaje: mismo tenant. ADEMÁS, un mensaje de chat PRIVADO (orderId pv_)
      // solo se acepta si SU conversación ya existe en bulk_conversaciones (creada por
      // el backend tras validar la matriz + misma compañía) y el AUTOR es participante.
      // Así la política de roles se hace cumplir en el BACKEND, no solo en el frontend:
      // nadie puede saltarse el picker y escribir directo a un pv_ no autorizado.
      allow create: if bSame(request.resource.data.tenantId)
        && ( !request.resource.data.orderId.matches('pv_.*')
             || ( exists(/databases/$(database)/documents/bulk_conversaciones/$(request.resource.data.orderId))
                  && request.auth.uid in get(/databases/$(database)/documents/bulk_conversaciones/$(request.resource.data.orderId)).data.participantes ) );
      allow update: if bSame(resource.data.tenantId);
      // Borrado permanente: el ADMIN (cualquier chat/mensaje) o el AUTOR de su propio
      // mensaje. Así un usuario no puede borrar mensajes de otros (requisito 13).
      allow delete: if bAdmin(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && resource.data.autorId == request.auth.uid);
    }
    // Grupos de chat. Solo los LEEN sus miembros, sus invitados (para ver/aceptar la
    // invitación) y el admin. TODA escritura (crear/invitar/aceptar/salir/expulsar/
    // disolver) pasa por la Cloud Function `bulkGrupoOp` (Admin SDK), que valida los
    // permisos en el backend — el cliente NO puede escribir aquí (requisito 14). Así
    // un usuario no puede colarse en un grupo ni invitar sin autorización.
    match /bulk_groups/{id} {
      allow read: if bSame(resource.data.tenantId) && (
           bAdmin(resource.data.tenantId)
        || request.auth.uid in resource.data.miembros
        || request.auth.uid in resource.data.invitados
      );
      allow create, update, delete: if false;
    }

    // Llamadas 1-a-1 (WebRTC). Solo los 2 participantes (quien llama y quien recibe)
    // pueden leer/escribir la señalización; el audio/video NO pasa por aquí, va P2P.
    // Los candidatos ICE viven en subcolecciones y heredan el mismo control.
    match /bulk_calls/{id} {
      // Uso de .get(...) para no fallar si a algún documento le falta un campo (eso
      // rompería la consulta LIST del listener con "permission-denied").
      function participa() {
        return bSame(resource.data.tenantId) && (
          request.auth.uid == resource.data.get('para', '')
          || request.auth.uid == resource.data.get('de', {}).get('uid', '')
        );
      }
      allow read: if participa() || bAdmin(resource.data.tenantId);
      allow create: if bSame(request.resource.data.tenantId) && request.resource.data.de.uid == request.auth.uid;
      allow update, delete: if participa();
      // Candidatos ICE: permitido a los participantes de la llamada padre.
      match /{lado}/{cid} {
        function llamada() { return get(/databases/$(database)/documents/bulk_calls/$(id)).data; }
        allow read, create, delete: if request.auth != null
          && (request.auth.uid == llamada().get('para', '') || request.auth.uid == llamada().get('de', {}).get('uid', ''));
      }
    }
    // Llamadas GRUPALES (WebRTC en malla). La sala (bulk_salas) lista quién está DENTRO
    // (participantes) y a quién le suena (invitados). Solo esas personas (o el admin)
    // leen/escriben la señalización; el audio/video va P2P entre cada pareja. Las señales
    // (oferta/respuesta/ICE) viven en la subcolección `senales` y heredan el control.
    match /bulk_salas/{id} {
      // .get(...) defensivo: si a un doc le falta un campo, no rompe la consulta LIST.
      function esMiembroSala() {
        return bSame(resource.data.tenantId) && (
          request.auth.uid in resource.data.get('participantes', {})
          || request.auth.uid in resource.data.get('invitados', [])
        );
      }
      allow read: if esMiembroSala() || bAdmin(resource.data.tenantId);
      allow create: if bSame(request.resource.data.tenantId) && request.resource.data.creadaPor == request.auth.uid;
      // Unirse/rechazar/invitar/salir: cualquier miembro o invitado (o admin), sin cambiar de empresa.
      allow update: if bSame(resource.data.tenantId)
        && request.resource.data.tenantId == resource.data.tenantId
        && (esMiembroSala() || bAdmin(resource.data.tenantId));
      allow delete: if esMiembroSala() || bAdmin(resource.data.tenantId);
      // Señalización por parejas: permitida a los participantes/invitados de la sala padre.
      match /senales/{sid} {
        function salaDoc() { return get(/databases/$(database)/documents/bulk_salas/$(id)).data; }
        function participaSala() {
          return request.auth != null && (
            request.auth.uid in salaDoc().get('participantes', {})
            || request.auth.uid in salaDoc().get('invitados', [])
            || bAdmin(salaDoc().tenantId)
          );
        }
        allow read, create, delete: if participaSala();
      }
    }
    match /bulk_trackpoints/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bSame(request.resource.data.tenantId); allow update, delete: if false; }

    // Eventos de GEOCERCA (entrada/salida de un chofer). Los CREA el chofer (su app),
    // pero él NO los lee: la NOTIFICACIÓN es solo para staff/admin y el transportista
    // del carrier (el push lo envía la Cloud Function bulkPushGeocerca; el cliente y el
    // chofer quedan excluidos). En-app los leen el staff y el transportista dueño.
    match /bulk_geoeventos/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.carrierId == bCarrier());
      allow create: if bSame(request.resource.data.tenantId);
      allow update: if false;
      allow delete: if bAdmin(resource.data.tenantId);
    }

    // Intenciones de notificación: las registra el cliente; el backend las procesa/lee.
    match /bulk_notificaciones/{id} { allow read: if bStaff(resource.data.tenantId); allow create: if bSame(request.resource.data.tenantId); allow update, delete: if false; }

    // Tokens de push (FCM): los lee el backend (Admin SDK, ignora reglas) para
    // enviar. En cliente solo el staff los lee; cada usuario registra el suyo.
    // Cada usuario registra/actualiza SOLO su propio token (data.uid == su uid);
    // el staff puede administrarlos. Antes cualquier miembro podía pisar el de otro
    // (el docId es el token FCM, no el uid).
    match /bulk_pushTokens/{id} {
      allow read: if bStaff(resource.data.tenantId);
      allow create, update: if bSame(request.resource.data.tenantId) && (request.resource.data.uid == request.auth.uid || bStaff(request.resource.data.tenantId));
      allow delete: if bStaff(resource.data.tenantId) || (bSame(resource.data.tenantId) && resource.data.uid == request.auth.uid);
    }

    // Presencia de choferes (en línea / disponible): la escribe cada chofer. La leen
    // el staff (para emparejar), el propio chofer, y su transportista (ver a su flota).
    match /bulk_presence/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && (request.auth.uid == id || resource.data.uid == request.auth.uid))
        || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.carrierId == bCarrier())
        // Un chofer puede ver el estado (en línea/ocupado) de sus CONTACTOS agregados.
        || (bSame(resource.data.tenantId) && exists(/databases/$(database)/documents/bulk_contacts/$(request.auth.uid)) && resource.data.uid in get(/databases/$(database)/documents/bulk_contacts/$(request.auth.uid)).data.get('contactos', []));
      // El propio chofer escribe la suya; staff, transportista y supervisor la
      // ajustan al asignar/reservar/liberar. Un chofer NO puede tocar la de otro.
      allow create, update: if bSame(request.resource.data.tenantId)
        && (request.auth.uid == id || bStaff(request.resource.data.tenantId) || bRole() in ['transportista', 'supervisor_planta']);
      allow delete: if bStaff(resource.data.tenantId) || (bSame(resource.data.tenantId) && request.auth.uid == id);
    }

    // Perfil del chofer (foto, datos, banco para pagos). El chofer edita el suyo
    // (docId = su uid); el staff lo lee (para pagarle). Datos bancarios visibles
    // solo para el dueño del perfil y el staff.
    match /bulk_driverProfiles/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && (request.auth.uid == id || resource.data.uid == request.auth.uid));
      // El chofer edita SU perfil y sube SUS documentos, pero NUNCA el campo
      // `verificaciones` (estado de verificación): eso es exclusivo del staff.
      allow create: if bSame(request.resource.data.tenantId)
        && (bStaff(request.resource.data.tenantId)
            || (request.auth.uid == id && !('verificaciones' in request.resource.data)));
      allow update: if bSame(request.resource.data.tenantId)
        && (bStaff(request.resource.data.tenantId)
            || (request.auth.uid == id
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificaciones'])));
      allow delete: if bStaff(resource.data.tenantId);
    }

    // Señal de cierre de sesión forzado: la escribe el staff; todos la leen para
    // saber si deben cerrar sesión.
    match /bulk_signals/{id} { allow read: if bSame(resource.data.tenantId); allow create, update: if bStaff(request.resource.data.tenantId); allow delete: if bAdmin(resource.data.tenantId); }

    // Contadores secuenciales por tenant (doc id = tenantId). Numeración de facturas/pagos.
    // Se usa el id (== tenantId) en la regla para permitir el get transaccional aun sin doc.
    match /bulk_counters/{id} {
      allow read: if bStaff(id);
      allow create, update: if bStaff(id);
    }

    // Correos del dominio (espejo de Google Workspace). SOLO admin. Las operaciones
    // reales contra Google las hace el backend (Admin SDK, bypassa reglas); el frontend
    // solo LEE. Se permite escritura a admin por si se edita el espejo desde el panel.
    match /bulk_mailboxes/{id} {
      allow read: if bAdmin(resource.data.tenantId);
      allow create, update, delete: if bAdmin(request.resource.data.tenantId) || bAdmin(resource.data.tenantId);
    }

    // Ajustes del sistema por tenant (id == tenantId). Incluye el mapeo de qué
    // dirección de correo usa cada función. Lee el staff; escribe solo admin.
    match /bulk_settings/{id} {
      allow read: if bStaff(resource.data.tenantId);
      allow create, update: if bAdmin(request.resource.data.tenantId);
    }

    // Reuniones (videollamadas con link de invitación). El staff del tenant LEE la
    // lista; TODAS las escrituras van por el backend (bulkMeetingOp). Los invitados
    // externos nunca tocan Firestore (entran vía la función con su código).
    match /bulk_meetings/{id} {
      allow read: if bStaff(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // Retiros Fast Pay (choferes Y carriers). Cada quien LEE los suyos; el staff
    // los del tenant. TODAS las escrituras van por el backend (/api/bulk-fastpay
    // con Admin SDK): el historial es permanente, nunca se edita ni borra.
    match /bulk_retiros/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && resource.data.choferId == request.auth.uid)
        || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.carrierId == bCarrier());
      allow create, update, delete: if false;
    }

    // Ledger transaccional de Fast Pay (autoridad del total retirado por persona).
    // Solo lo escribe el backend; el staff puede leerlo para auditoría.
    match /bulk_fpLedger/{id} {
      allow read: if bStaff(resource.data.tenantId);
      allow create, update, delete: if false;
    }

    // Reglas de FACTURAS RECURRENTES (programación por cliente/periodo). El staff
    // las gestiona (crear/pausar/borrar); cada factura la GENERA el backend
    // (bulkFacturasRecurrentes con Admin SDK), no el cliente.
    match /bulk_recurrentes/{id} {
      allow read: if bStaff(resource.data.tenantId);
      allow create: if bStaff(request.resource.data.tenantId);
      allow update, delete: if bStaff(resource.data.tenantId);
    }

    // Auditoría: se crea por cualquier miembro; solo admin lee; no se edita/borra.
    match /bulk_audit/{id} { allow read: if bAdmin(resource.data.tenantId); allow create: if bSame(request.resource.data.tenantId); allow update, delete: if false; }
  }
}
