rules_version = '2';

// ---------------------------------------------------------------------------
// Reglas de seguridad multi-empresa para MilePay.
// Aislamiento por companyId: un usuario solo accede a documentos cuya
// companyId coincide con la de su documento en `users`. El súper-admin
// (users/{uid}.superAdmin == true) accede a todo.
//
// ROL "driver" (chofer): acceso MUY limitado. Solo puede LEER:
//   - su propio documento en `drivers` (el de su driverId)
//   - sus propios `claims` (donde courier == su driverNombre)
//   - sus propios `payroll` y `driverStats` (donde driverNombre/driverKey == el suyo)
//   NO puede leer invoices, otros drivers, users, companies, managers, settings
//   ni alertEstados. Tampoco puede escribir en ninguna colección de datos.
//
// Desplegar con:  firebase deploy --only firestore:rules
// (o pegar en Firebase Console → Firestore → Reglas)
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // Súper-admin por CORREO verificado (respaldo "break-glass"): garantiza el
    // acceso del dueño de la plataforma aunque su doc en `users` tenga cualquier
    // problema. Edita esta lista con tu(s) correo(s) de súper-admin.
    function isSuperEmail() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['gabriele.brandonisio.o@gmail.com'];
    }
    // Súper-admin: por correo (respaldo) o por flag superAdmin==true en su doc.
    function isSuper() {
      return isSuperEmail() || (hasProfile() && userDoc().superAdmin == true);
    }
    function role() {
      return hasProfile() ? userDoc().role : '';
    }
    function isDriver() {
      return role() == 'driver';
    }
    // Personal = staff de la empresa (owner/admin/manager/súper-admin), NO chofer.
    function isStaff(cid) {
      return isSuper() || (hasProfile() && !isDriver() && userDoc().companyId == cid);
    }
    function myCompany() {
      return hasProfile() ? userDoc().companyId : null;
    }
    // Datos "de empresa" (finanzas, agregados): solo staff, NUNCA un chofer.
    function inCompany(cid) {
      return isStaff(cid);
    }
    // Nombre / clave / id del chofer vinculado al usuario (rol driver).
    function myDriverName() {
      return hasProfile() ? userDoc().driverNombre : '';
    }
    function myDriverKey() {
      return hasProfile() ? userDoc().driverKey : '';
    }
    function myDriverId() {
      return hasProfile() ? userDoc().driverId : '';
    }

    // Empresas: solo staff de esa empresa o súper-admin. Escritura súper-admin.
    match /companies/{companyId} {
      allow read: if isStaff(companyId);
      allow create, update, delete: if isSuper();
    }

    // Usuarios: cada uno lee su PROPIO doc. El staff (no chofer) lee los usuarios de
    // su empresa. Un chofer solo puede leer su propio documento.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper() || (hasProfile() && !isDriver() && myCompany() == resource.data.companyId));
      // Crear / editar / borrar usuarios: SOLO el dueño (o súper-admin) de la empresa.
      // Así un manager no puede cambiar roles ni permisos de nadie.
      allow create, update, delete: if isSuper() || (hasProfile() && role() == 'owner' && myCompany() == request.resource.data.companyId);
      // Excepción: CUALQUIER usuario puede guardar SOLO su preferencia de filtro
      // (prefFiltro) en su propio doc — sin poder tocar rol, permisos, ciudad ni empresa.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefFiltro']);
    }

    // Facturas / agregados financieros: solo staff. Un chofer NO puede leerlas.
    match /invoices/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Drivers: el staff gestiona todos; un chofer solo LEE su propio doc.
    match /drivers/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && id == myDriverId());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Claims: el staff gestiona todos; un chofer solo LEE los suyos (courier == su nombre).
    match /claims/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && resource.data.courier == myDriverName());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Nómina: el staff gestiona; un chofer solo LEE la suya (driverNombre == su nombre).
    match /payroll/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && resource.data.driverNombre == myDriverName());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Resumen por chofer y semana (para el portal del chofer). El chofer solo lee
    // las filas suyas (driverKey == la suya). Lo escribe el staff al cargar facturas.
    match /driverStats/{id} {
      allow read: if isStaff(resource.data.companyId) || (isDriver() && resource.data.driverKey == myDriverKey());
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // Managers (costo de empresa): solo staff.
    match /managers/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }
    // Estado de alertas: solo staff.
    match /alertEstados/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }
    // Configuración por empresa: solo staff.
    match /settings/{id} {
      allow read: if isStaff(resource.data.companyId);
      allow create: if isStaff(request.resource.data.companyId);
      allow update, delete: if isStaff(resource.data.companyId);
    }

    // =========================================================================
    // MÓDULO BULK — namespace `bulk_*` (independiente de Package).
    // Requiere Firebase Auth con CUSTOM CLAIMS puestas por el backend
    // (functions: crearUsuarioBulk / bootstrapMasterBulk):
    //   token.bulkTenant, token.bulkRole, token.bulkClienteId?, token.bulkCarrierId?
    // Aislamiento estricto por bulkTenant. Los usuarios se crean por el backend
    // (Admin SDK), por eso `bulk_users` no acepta escritura directa del cliente.
    // =========================================================================
    function bT() { return request.auth != null ? request.auth.token.bulkTenant : null; }
    function bRole() { return request.auth != null ? request.auth.token.bulkRole : null; }
    function bSigned() { return request.auth != null && bT() != null; }
    function bSame(cid) { return bSigned() && bT() == cid; }
    function bStaff(cid) { return bSame(cid) && (bRole() in ['super_admin', 'admin', 'dispatcher']); }
    function bAdmin(cid) { return bSame(cid) && (bRole() in ['super_admin', 'admin']); }
    function bCliente() { return request.auth != null ? request.auth.token.bulkClienteId : null; }
    function bCarrier() { return request.auth != null ? request.auth.token.bulkCarrierId : null; }
    // Planta asignada al supervisor (en su doc de usuario). Para acotar sus lecturas.
    function bMyPlanta() { return request.auth != null && exists(/databases/$(database)/documents/bulk_users/$(request.auth.uid)) ? get(/databases/$(database)/documents/bulk_users/$(request.auth.uid)).data.plantaId : null; }

    // Perfiles Bulk: lee el propio o admin del tenant. Alta/edición: backend (Admin SDK).
    match /bulk_users/{id} {
      allow read: if bSame(resource.data.tenantId) && (request.auth.uid == id || bAdmin(resource.data.tenantId));
      // Alta/edición general: backend (Admin SDK). Excepción: el admin del tenant
      // puede asignar SOLO la planta de un supervisor (campo plantaId), sin tocar
      // rol, tenant ni credenciales.
      allow update: if bAdmin(resource.data.tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plantaId']);
      allow create, delete: if false;
    }

    // Catálogos y entidades gestionadas por staff del tenant.
    match /bulk_clients/{id}   { allow read: if bStaff(resource.data.tenantId); allow create: if bStaff(request.resource.data.tenantId); allow update, delete: if bStaff(resource.data.tenantId); }
    match /bulk_plants/{id}    { allow read: if bStaff(resource.data.tenantId); allow create: if bStaff(request.resource.data.tenantId); allow update, delete: if bStaff(resource.data.tenantId); }
    match /bulk_jobs/{id}      { allow read: if bStaff(resource.data.tenantId); allow create: if bStaff(request.resource.data.tenantId); allow update, delete: if bStaff(resource.data.tenantId); }
    match /bulk_carriers/{id}  { allow read: if bSame(resource.data.tenantId); allow create: if bStaff(request.resource.data.tenantId); allow update, delete: if bStaff(resource.data.tenantId); }
    // Config del transportista (cómo le paga a sus choferes). SOLO el propio
    // transportista (rol transportista + su carrierId) o el staff. Un chofer NO
    // puede leerla ni escribirla aunque comparta bulkCarrierId (fuga L5 cerrada).
    match /bulk_carrierConfig/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(resource.data.tenantId) && bCarrier() == id);
      allow create: if bStaff(request.resource.data.tenantId) || (bRole() == 'transportista' && bSame(request.resource.data.tenantId) && bCarrier() == id);
      allow update: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(request.resource.data.tenantId) && bCarrier() == id);
      allow delete: if bStaff(resource.data.tenantId);
    }
    // Avisos de pago a transportistas (los emite el staff; el transportista lee los suyos).
    match /bulk_carrierStatements/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.carrierId == bCarrier());
      allow create: if bStaff(request.resource.data.tenantId);
      allow update, delete: if bStaff(resource.data.tenantId);
    }
    match /bulk_materials/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_equipment/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_geofences/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_tariffs/{id}   { allow read: if bStaff(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }
    match /bulk_incidents/{id} { allow read: if bStaff(resource.data.tenantId); allow create, update: if bStaff(request.resource.data.tenantId) || bStaff(resource.data.tenantId); allow delete: if bAdmin(resource.data.tenantId); }
    match /bulk_documents/{id} { allow read: if bStaff(resource.data.tenantId); allow create: if bAdmin(request.resource.data.tenantId); allow update, delete: if bAdmin(resource.data.tenantId); }

    // Órdenes: staff todo; chofer las suyas; transportista las de su carrier; cliente las suyas.
    match /bulk_orders/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && (
             (bRole() == 'chofer' && (resource.data.choferId == request.auth.uid || resource.data.transportistaId == bCarrier()))
          || (bRole() == 'transportista' && resource.data.transportistaId == bCarrier())
          || (bRole() == 'cliente' && resource.data.clienteId == bCliente())
          || (bRole() == 'supervisor_planta' && bMyPlanta() != null && resource.data.plantaId == bMyPlanta())));
      allow create: if bStaff(request.resource.data.tenantId);
      // Los roles NO-staff pueden avanzar la operación (estado, hitos, ticket,
      // POD, GPS…) pero NUNCA modificar los precios. Guardas por campo:
      //  - precioCliente y precioTransportista: intocables por cualquier no-staff.
      //  - pagoChofer: el transportista SÍ lo fija al asignar a su chofer; el
      //    chofer y el supervisor NO pueden tocarlo.
      allow update: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId)
            && request.resource.data.precioCliente == resource.data.precioCliente
            && request.resource.data.precioTransportista == resource.data.precioTransportista
            && (
             (bRole() == 'transportista' && resource.data.transportistaId == bCarrier())
          || (bRole() == 'chofer' && (resource.data.choferId == request.auth.uid || resource.data.transportistaId == bCarrier())
                && request.resource.data.pagoChofer == resource.data.pagoChofer)
          || (bRole() == 'supervisor_planta'
                && resource.data.plantaId == bMyPlanta()
                && request.resource.data.pagoChofer == resource.data.pagoChofer)));
      allow delete: if bAdmin(resource.data.tenantId);
    }

    // ── Inc.2 · Pagos por audiencia (separación de márgenes) ─────────────────
    // Cada orden proyecta su precio a 3 docs (mismo id que la orden) para que cada
    // rol lea SOLO su número. Los precios de cliente y transportista los fija SOLO
    // el staff (nadie puede inflar lo que se le cobra/paga). El pago al chofer lo
    // fija su transportista.
    match /bulk_orderPay_cliente/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'cliente' && bSame(resource.data.tenantId) && resource.data.clienteId == bCliente());
      allow create, update, delete: if bStaff(request.resource.data.tenantId) || bStaff(resource.data.tenantId);
    }
    match /bulk_orderPay_carrier/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.transportistaId == bCarrier());
      allow create, update, delete: if bStaff(request.resource.data.tenantId) || bStaff(resource.data.tenantId);
    }
    match /bulk_orderPay_chofer/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bRole() == 'chofer' && bSame(resource.data.tenantId) && resource.data.choferId == request.auth.uid)
        || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.transportistaId == bCarrier());
      allow create, update: if bStaff(request.resource.data.tenantId)
        || (bRole() == 'transportista' && bSame(request.resource.data.tenantId) && request.resource.data.transportistaId == bCarrier());
      allow delete: if bStaff(resource.data.tenantId);
    }

    // Facturas: staff crea; cliente lee/firma las suyas.
    match /bulk_invoices/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bRole() == 'cliente' && bSame(resource.data.tenantId) && resource.data.clienteId == bCliente());
      allow create: if bStaff(request.resource.data.tenantId);
      // El cliente puede FIRMAR (estado='firmada') o DISPUTAR (estado='rechazada')
      // su factura — solo esos campos. No puede tocar total, líneas ni marcarla pagada.
      allow update: if bStaff(resource.data.tenantId)
        || (bRole() == 'cliente' && bSame(resource.data.tenantId) && resource.data.clienteId == bCliente()
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'firma', 'firmante', 'firmadaEn']) && request.resource.data.estado == 'firmada')
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivoRechazo', 'rechazadaEn']) && request.resource.data.estado == 'rechazada')
            ));
      allow delete: if bAdmin(resource.data.tenantId);
    }

    // Mensajes de orden y GPS: cualquier miembro autenticado del tenant.
    // Mensajes de orden y oficina. Los chats de ORDEN llevan `participantes` (uid del
    // chofer, id del carrier, id del cliente, autor): solo ellos + staff los leen. Los
    // de oficina (sin ese campo) siguen legibles por cualquier miembro del tenant (el
    // staff y el interlocutor; el cliente no descarga chats ajenos por consulta).
    match /bulk_messages/{id} {
      allow read: if bSame(resource.data.tenantId) && (
           bStaff(resource.data.tenantId)
        || !('participantes' in resource.data)
        || request.auth.uid in resource.data.participantes
        || (bCarrier() != null && bCarrier() in resource.data.participantes)
        || (bCliente() != null && bCliente() in resource.data.participantes)
      );
      allow create: if bSame(request.resource.data.tenantId);
      allow update: if bSame(resource.data.tenantId);
      allow delete: if bAdmin(resource.data.tenantId);
    }
    match /bulk_trackpoints/{id} { allow read: if bSame(resource.data.tenantId); allow create: if bSame(request.resource.data.tenantId); allow update, delete: if false; }

    // Intenciones de notificación: las registra el cliente; el backend las procesa/lee.
    match /bulk_notificaciones/{id} { allow read: if bStaff(resource.data.tenantId); allow create: if bSame(request.resource.data.tenantId); allow update, delete: if false; }

    // Tokens de push (FCM): los lee el backend (Admin SDK, ignora reglas) para
    // enviar. En cliente solo el staff los lee; cada usuario registra el suyo.
    // Cada usuario registra/actualiza SOLO su propio token (data.uid == su uid);
    // el staff puede administrarlos. Antes cualquier miembro podía pisar el de otro
    // (el docId es el token FCM, no el uid).
    match /bulk_pushTokens/{id} {
      allow read: if bStaff(resource.data.tenantId);
      allow create, update: if bSame(request.resource.data.tenantId) && (request.resource.data.uid == request.auth.uid || bStaff(request.resource.data.tenantId));
      allow delete: if bStaff(resource.data.tenantId) || (bSame(resource.data.tenantId) && resource.data.uid == request.auth.uid);
    }

    // Presencia de choferes (en línea / disponible): la escribe cada chofer. La leen
    // el staff (para emparejar), el propio chofer, y su transportista (ver a su flota).
    match /bulk_presence/{id} {
      allow read: if bStaff(resource.data.tenantId)
        || (bSame(resource.data.tenantId) && (request.auth.uid == id || resource.data.uid == request.auth.uid))
        || (bRole() == 'transportista' && bSame(resource.data.tenantId) && resource.data.carrierId == bCarrier());
      // El propio chofer escribe la suya; staff, transportista y supervisor la
      // ajustan al asignar/reservar/liberar. Un chofer NO puede tocar la de otro.
      allow create, update: if bSame(request.resource.data.tenantId)
        && (request.auth.uid == id || bStaff(request.resource.data.tenantId) || bRole() in ['transportista', 'supervisor_planta']);
      allow delete: if bStaff(resource.data.tenantId) || (bSame(resource.data.tenantId) && request.auth.uid == id);
    }

    // Perfil del chofer (foto, datos, banco para pagos). El chofer edita el suyo
    // (docId = su uid); el staff lo lee (para pagarle). Datos bancarios visibles
    // solo para el dueño del perfil y el staff.
    match /bulk_driverProfiles/{id} {
      allow read: if bStaff(resource.data.tenantId) || (bSame(resource.data.tenantId) && request.auth.uid == id);
      allow create, update: if bSame(request.resource.data.tenantId) && (request.auth.uid == id || bStaff(request.resource.data.tenantId));
      allow delete: if bStaff(resource.data.tenantId);
    }

    // Señal de cierre de sesión forzado: la escribe el staff; todos la leen para
    // saber si deben cerrar sesión.
    match /bulk_signals/{id} { allow read: if bSame(resource.data.tenantId); allow create, update: if bStaff(request.resource.data.tenantId); allow delete: if bAdmin(resource.data.tenantId); }

    // Contadores secuenciales por tenant (doc id = tenantId). Numeración de facturas/pagos.
    // Se usa el id (== tenantId) en la regla para permitir el get transaccional aun sin doc.
    match /bulk_counters/{id} {
      allow read: if bStaff(id);
      allow create, update: if bStaff(id);
    }

    // Auditoría: se crea por cualquier miembro; solo admin lee; no se edita/borra.
    match /bulk_audit/{id} { allow read: if bAdmin(resource.data.tenantId); allow create: if bSame(request.resource.data.tenantId); allow update, delete: if false; }
  }
}
